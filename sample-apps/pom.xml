<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.capture</groupId>
    <artifactId>ejb-capture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <groupId>io.capture.samples</groupId>
  <artifactId>sample-apps</artifactId>
  <packaging>pom</packaging>
  <name>sample-apps</name>

  <modules>
    <module>common-dto</module>
    <module>orders-api</module>
    <module>tax-api</module>
    <module>tax-ear</module>
    <module>orders-ear</module>
  </modules>

  <dependencies>
    <dependency>
      <groupId>javax</groupId>
      <artifactId>javaee-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      The same sources for WebLogic 12.2.1.4 / JDK 8: Java 8 bytecode, compiled against the
      Java EE 7 API so nothing EE 8-only slips in. `wls-deploy` selects it for WLS_VERSION=12.
    -->
    <profile>
      <id>java8</id>
      <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <javaee-api.version>7.0</javaee-api.version>
      </properties>
    </profile>
  </profiles>
</project>
