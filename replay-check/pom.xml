<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.capture</groupId>
    <artifactId>ejb-capture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>replay-check</artifactId>
  <packaging>jar</packaging>
  <name>replay-check</name>
  <description>One JUnit test: a captured remote EJB span replays over T3 against the running domain. Skipped when the server is down.</description>

  <dependencies>
    <dependency>
      <groupId>io.capture</groupId>
      <artifactId>trace-model</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The agent's GraphReader (JacksonGraphSerializer.deserialize), from the shaded jar. -->
    <dependency>
      <groupId>io.capture</groupId>
      <artifactId>capture-agent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The interfaces and DTOs the captured span names: the sample *-api jars. -->
    <dependency>
      <groupId>io.capture.samples</groupId>
      <artifactId>orders-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>javax</groupId>
      <artifactId>javaee-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- wlthint3client.jar and eclipselink.jar are loaded from the install at run time. -->
          <environmentVariables>
            <ORACLE_HOME>${env.ORACLE_HOME}</ORACLE_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
