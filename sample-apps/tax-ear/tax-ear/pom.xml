<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.capture.samples</groupId>
    <artifactId>tax-ear-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tax-ear</artifactId>
  <packaging>ear</packaging>
  <name>tax-ear</name>

  <dependencies>
    <dependency>
      <groupId>io.capture.samples</groupId>
      <artifactId>tax-ejb</artifactId>
      <type>ejb</type>
    </dependency>
    <dependency>
      <groupId>io.capture.samples</groupId>
      <artifactId>tax-web</artifactId>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>io.capture.samples</groupId>
      <artifactId>tax-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.capture.samples</groupId>
      <artifactId>common-dto</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>tax-ear</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-ear-plugin</artifactId>
        <configuration>
          <applicationName>tax-ear</applicationName>
          <modules>
            <ejbModule>
              <groupId>io.capture.samples</groupId>
              <artifactId>tax-ejb</artifactId>
            </ejbModule>
            <webModule>
              <groupId>io.capture.samples</groupId>
              <artifactId>tax-web</artifactId>
              <contextRoot>/tax</contextRoot>
            </webModule>
          </modules>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
