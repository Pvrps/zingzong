<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ca.gc.cra.xz02.devops</groupId>
    <artifactId>weblogic-trace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>weblogic-trace-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>weblogic-trace-maven-plugin</name>
  <description>
    wltrace:enable / wltrace:disable install or remove the capture agent in a WebLogic domain;
    wltrace:start serves the page where captures are started, stopped, watched and viewed.
    Runs inside the developer's Maven JDK (8 or later), hence --release 8.
  </description>

  <properties>
    <maven.version>3.6.3</maven.version>
    <maven-plugin-tools.version>3.15.1</maven-plugin-tools.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>ca.gc.cra.xz02.devops</groupId>
      <artifactId>weblogic-trace-model</artifactId>
    </dependency>
    <!--
      The agent jar wltrace:enable installs. Kept as a plain dependency (not shaded in) so
      Maven resolves it next to the plugin and the goal finds it among the plugin's artifacts.
    -->
    <dependency>
      <groupId>ca.gc.cra.xz02.devops</groupId>
      <artifactId>weblogic-trace-agent</artifactId>
      <version>${project.version}</version>
      <!-- The agent jar is self-contained (shaded); its pom's dependencies are not wanted here. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
        <configuration>
          <goalPrefix>wltrace</goalPrefix>
        </configuration>
        <executions>
          <execution>
            <id>help-goal</id>
            <goals>
              <goal>helpmojo</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Everything but the agent jar is shaded in and relocated: the Maven JVM has its own Jackson. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <artifactSet>
                <excludes>
                  <exclude>ca.gc.cra.xz02.devops:weblogic-trace-agent</exclude>
                </excludes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>ca.gc.cra.xz02.devops.wltrace.shaded.com.fasterxml.jackson</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
