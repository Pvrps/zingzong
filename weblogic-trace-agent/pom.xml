<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ca.gc.cra.xz02.devops</groupId>
    <artifactId>weblogic-trace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>weblogic-trace-agent</artifactId>
  <packaging>jar</packaging>
  <name>weblogic-trace-agent</name>
  <description>The -javaagent. No javax.* or weblogic.* compile dependencies; ByteBuddy and Jackson shaded.</description>

  <properties>
    <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    <!-- JDK 8 (what a 12.2.1.4 domain and its Maven run on): no module system, no add-opens; see the jdk9plus profile. -->
    <agent.test.argLine>-Djdk.attach.allowAttachSelf=true</agent.test.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ca.gc.cra.xz02.devops</groupId>
      <artifactId>weblogic-trace-model</artifactId>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope only: the fake @Stateless beans to instrument and the JPA annotations on the
         Order fixture. The agent itself never links to javax. -->
    <dependency>
      <groupId>javax</groupId>
      <artifactId>javaee-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope only: real IndirectList/ValueHolder for the lazy-detection tests. -->
    <dependency>
      <groupId>org.eclipse.persistence</groupId>
      <artifactId>eclipselink</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>weblogic-trace-agent</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <!-- build.properties carries the version into recording.json -->
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Tests install the hook on their own JVM via ByteBuddyAgent; see the jdk9plus profile for the add-opens. -->
          <argLine>${agent.test.argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>ca.gc.cra.xz02.devops.wltrace.shaded.net.bytebuddy</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>ca.gc.cra.xz02.devops.wltrace.shaded.com.fasterxml.jackson</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>ca.gc.cra.xz02.devops.wltrace.agent.bootstrap.AgentMain</Premain-Class>
                    <Agent-Class>ca.gc.cra.xz02.devops.wltrace.agent.bootstrap.AgentMain</Agent-Class>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- JDK 9+: self-attach must be allowed, and the add-opens mirror what wltrace:enable writes
           into the domain, so the serializer sees the same JDK fields in tests as on the server. -->
      <id>jdk9plus</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <agent.test.argLine>-Djdk.attach.allowAttachSelf=true
          --add-opens=java.base/java.lang=ALL-UNNAMED
          --add-opens=java.base/java.util=ALL-UNNAMED
          --add-opens=java.base/java.time=ALL-UNNAMED
          --add-opens=java.sql/java.sql=ALL-UNNAMED
          --add-opens=java.logging/java.util.logging=ALL-UNNAMED</agent.test.argLine>
      </properties>
    </profile>
  </profiles>
</project>
