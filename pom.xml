<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.capture</groupId>
  <artifactId>ejb-capture-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ejb-capture</name>
  <description>Java agent that records EJB and HTTP invocations on WebLogic as JSON traces, plus tooling.</description>

  <!--
    Modules are listed as they come into existence; Maven fails on a missing module directory.
    Phase 0: sample-apps/common-dto, sample-apps/orders-ear/*, sample-apps/tax-ear/*
    Phase 1: trace-model, capture-agent
    Phase 7: trace-tools/*, replay-check
  -->
  <modules>
    <module>trace-model</module>
    <module>capture-agent</module>
    <module>trace-tools</module>
    <module>sample-apps</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Server, sample apps and tooling. capture-agent and trace-model (shaded into it) override this with 8. -->
    <maven.compiler.release>21</maven.compiler.release>
    <agent.compiler.release>8</agent.compiler.release>

    <!-- Java EE 8 / Jakarta EE 8: javax.* namespace on both WebLogic 12.2.1 and 14.1.2. -->
    <javaee-api.version>8.0.1</javaee-api.version>
    <bytebuddy.version>1.17.5</bytebuddy.version>
    <jackson.version>2.19.0</jackson.version>
    <junit.version>5.12.2</junit.version>
    <h2.version>2.3.232</h2.version>
    <!-- Same EclipseLink as bundled with WebLogic 14.1.2; test scope only, for lazy-collection fixtures. -->
    <eclipselink.version>2.7.15</eclipselink.version>
    <json-schema-validator.version>1.5.9</json-schema-validator.version>

    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    <maven-ejb-plugin.version>3.2.1</maven-ejb-plugin.version>
    <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
    <maven-ear-plugin.version>3.3.0</maven-ear-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>javax</groupId>
        <artifactId>javaee-api</artifactId>
        <version>${javaee-api.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>${bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy-agent</artifactId>
        <version>${bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.persistence</groupId>
        <artifactId>eclipselink</artifactId>
        <version>${eclipselink.version}</version>
      </dependency>

      <!-- In-repo modules -->
      <dependency>
        <groupId>io.capture</groupId>
        <artifactId>trace-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>common-dto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>orders-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>tax-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>orders-ejb</artifactId>
        <version>${project.version}</version>
        <type>ejb</type>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>orders-web</artifactId>
        <version>${project.version}</version>
        <type>war</type>
      </dependency>
      <dependency>
        <groupId>io.capture.samples</groupId>
        <artifactId>tax-ejb</artifactId>
        <version>${project.version}</version>
        <type>ejb</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ejb-plugin</artifactId>
          <version>${maven-ejb-plugin.version}</version>
          <configuration>
            <ejbVersion>3.2</ejbVersion>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>${maven-war-plugin.version}</version>
          <configuration>
            <failOnMissingWebXml>false</failOnMissingWebXml>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ear-plugin</artifactId>
          <version>${maven-ear-plugin.version}</version>
          <configuration>
            <!-- Java EE 7 descriptor: accepted by both 12.2.1 and 14.1.2. -->
            <version>7</version>
            <defaultLibBundleDir>lib</defaultLibBundleDir>
            <!-- Module file names become java:global module names, keep them version-free. -->
            <outputFileNameMapping>@{artifactId}@.@{extension}@</outputFileNameMapping>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
