<?xml version="1.0" encoding="UTF-8"?>
<!-- Only RateLookup is declared here (EJB 2.x style); TaxServiceBean is annotated. metadata-complete is false by default. -->
<ejb-jar xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/ejb-jar_3_2.xsd"
         version="3.2">
  <enterprise-beans>
    <session>
      <ejb-name>RateLookup</ejb-name>
      <home>com.acme.tax.api.RateLookupHome</home>
      <remote>com.acme.tax.api.RateLookup</remote>
      <ejb-class>com.acme.tax.RateLookupBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
    </session>
  </enterprise-beans>
</ejb-jar>
